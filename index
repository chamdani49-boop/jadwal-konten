// ═══════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════
let GAS_URL   = localStorage.getItem("gasUrl")||"";
let LIVE_DATA = null;
let STATUS    = {}; // rowNum → status
let CUR_DAY   = 0;

// ═══════════════════════════════════════════════════════
// DEMO DATA BUILDER
// ═══════════════════════════════════════════════════════
function buildDemo(){
  const rows=[];
  STOCKS.forEach((s,di)=>{
    const st=SORE[di];
    [{t:"08.00",sl:"Radar"},{t:"12.00",sl:"Kalkulator"},{t:"16.00",sl:st},{t:"20.00",sl:"Dashboard"}]
    .forEach((x,si)=>{
      rows.push({row:3+di*4+si,day:di+1,date:`Hari ${di+1}`,time:x.t,stock:s,slot:x.sl,
        label:{Radar:"Hook",Kalkulator:"Value",Dashboard:"Closing"}[x.sl]||"Trust",
        copy:mkCopy(x.sl,s),link:LINKS[x.sl]||"",status:"Belum",notes:""});
    });
  });
  return rows;
}
function mkCopy(sl,s){
  if(sl==="Radar") return `${s} sekarang ada di area bawah historisnya\nApakah ini peluang akumulasi atau jebakan?`;
  if(sl==="Kalkulator") return `Nilai wajar ${s} masih di atas harga sekarang\nPotensi upside masih menarik untuk diperhatikan`;
  if(sl==="Data 1%") return `Yang jarang diperhatikan:\nKepemilikan >1% di ${s} dipegang pemain besar\nIni bukan saham "kosong"`;
  if(sl==="Insight") return `Banyak orang fokus harga ${s}\nPadahal yang lebih penting:\nposisi dan siapa yang pegang`;
  if(sl==="Edukasi") return `Sebelum beli ${s}, pahami dulu satu hal ini...\nBanyak yang skip bagian ini`;
  return `Dari pagi kita sudah bahas ${s}\nLihat data lengkapnya di dashboard sekarang\nArea beli, tren, target — semua ada`;
}
function getContent(){ return LIVE_DATA?LIVE_DATA.content:buildDemo(); }
function getTargets(){ return LIVE_DATA?LIVE_DATA.targets:TARGETS; }
function getKPIData(){ return LIVE_DATA?LIVE_DATA.kpi:KPI_META.map((k,i)=>({row:4+i,...k,w1:"",w2:"",w3:"",w4:""})); }
function calcProg(rows){
  const bd={};
  rows.forEach(r=>{
    if(!bd[r.day]) bd[r.day]={total:0,done:0};
    bd[r.day].total++;
    if((STATUS[r.row]||r.status)==="Sudah") bd[r.day].done++;
  });
  return {doneDays:Object.values(bd).filter(d=>d.done===d.total&&d.total>0).length,byDay:bd};
}

// ═══════════════════════════════════════════════════════
// GAS
// ═══════════════════════════════════════════════════════
async function gasCall(action,extra={}){
  if(!GAS_URL) return null;
  try{
    const r=await fetch(GAS_URL,{method:"POST",body:JSON.stringify({action,...extra})});
    return await r.json();
  }catch(e){return null;}
}
async function syncGAS(){
  if(!GAS_URL){toast("Hubungkan Google Sheet dulu");return;}
  toast("Sinkronisasi...");
  const d=await gasCall("getAll");
  if(d&&d.ok){
    LIVE_DATA=d;
    STATUS={};
    d.content.forEach(r=>{STATUS[r.row]=r.status;});
    renderAll();
    document.getElementById("sync-st").textContent="Sync: "+new Date().toLocaleTimeString("id-ID");
    toast("Data berhasil disinkron dari Google Sheet ✓");
  } else {
    toast("Gagal sync — cek URL atau jalankan ulang deployment");
  }
}
function connectGAS(){
  const u=document.getElementById("gas-url").value.trim();
  if(!u.startsWith("https://script.google.com")){toast("URL tidak valid");return;}
  GAS_URL=u; localStorage.setItem("gasUrl",u);
  document.getElementById("setup-box").style.display="none";
  const b=document.getElementById("mode-badge");
  b.className="badge badge-live"; b.textContent="Live — Google Sheet";
  syncGAS();
}

// ═══════════════════════════════════════════════════════
// RENDER ALL
// ═══════════════════════════════════════════════════════
function renderAll(){
  const rows=getContent();
  const prog=calcProg(rows);
  const tgts=getTargets();
  const kpis=getKPIData();
  renderStats(rows,prog);
  renderTargetMini(tgts);
  renderTargetFull(tgts);
  renderKPISnap(kpis);
  renderLevelGrid(tgts);
  renderDayGrid(rows);
  renderDetail(CUR_DAY,rows);
  renderKPI(kpis);
  renderTemplates();
  renderAI();
}

function renderStats(rows,prog){
  const posted=rows.filter(r=>(STATUS[r.row]||r.status)==="Sudah").length;
  const pct=Math.round(posted/Math.max(rows.length,1)*100);
  document.getElementById("s-done").textContent=prog.doneDays;
  document.getElementById("s-slots").textContent=rows.length;
  document.getElementById("s-post").textContent=posted;
  document.getElementById("s-pct").textContent=pct+"%";
  document.getElementById("prog-big").textContent=pct+"%";
  document.getElementById("prog-fill").style.width=pct+"%";
  [[1,7],[8,14],[15,21],[22,30]].forEach(([s,e],wi)=>{
    let dn=0,tot=0;
    for(let d=s;d<=e;d++){const bd=prog.byDay[d];if(bd){tot++;if(bd.done===bd.total&&bd.total>0)dn++;}}
    const max=e-s+1,h=Math.max(6,Math.round(dn/max*40));
    const wb=document.getElementById("wb"+(wi+1)),wc=document.getElementById("wc"+(wi+1));
    if(wb){wb.style.height=h+"px";wb.className="wk-bar "+(dn===max?"full":dn>0?"part":"");}
    if(wc) wc.textContent=dn+"/"+max;
  });
}

function renderTargetMini(tgts){
  document.getElementById("tbl-mini").innerHTML=tgts.map(t=>
    `<tr><td>${t.metric}</td><td class="cr">${t.real}</td><td class="ct">${t.mid}</td><td class="ca">${t.aggr}</td></tr>`
  ).join("");
}
function renderTargetFull(tgts){
  document.getElementById("tbl-full").innerHTML=tgts.map((t,i)=>
    `<tr><td>${t.metric}</td><td class="cr">${t.real}</td><td class="ct">${t.mid}</td><td class="ca">${t.aggr}</td>
     <td><input class="act-in" value="${t.actual||""}" placeholder="isi aktual" onblur="saveActual(${t.row||i+5},this.value)"></td></tr>`
  ).join("");
}
function renderKPISnap(kpis){
  const el=document.getElementById("kpi-snap");
  if(!el) return;
  el.innerHTML=kpis.slice(0,4).map(k=>{
    const v=k.w4||k.w3||k.w2||k.w1||"—";
    return `<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--bdr);font-size:12px">
      <span style="color:var(--txt2)">${k.kpi}</span>
      <span style="font-family:'Space Mono',monospace;color:var(--gold)">${v}</span></div>`;
  }).join("")+`<div style="font-size:11px;color:var(--txt3);margin-top:10px">Update lengkap di tab KPI Tracker →</div>`;
}

// Level Grid (Target page)
function renderLevelGrid(tgts){
