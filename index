}

// ── Day Grid ───────────────────────────────────────────────
const SLOT_COL={Radar:"var(--hook)",Kalkulator:"var(--value)",Dashboard:"var(--close)"};
function renderDayGrid(rows){
  const grid=document.getElementById("day-grid"); if(!grid) return;
  const byDay={};
  rows.forEach(r=>{if(!byDay[r.day])byDay[r.day]=[];byDay[r.day].push(r);});
  grid.innerHTML="";
  for(let d=1;d<=30;d++){
    const dr=byDay[d]||[],s=dr[0]?dr[0].stock:STOCKS[d-1];
    const allDone=dr.length>0&&dr.every(r=>(STATUS[r.row]||r.status)==="Sudah");
    const chip=document.createElement("div");
    chip.className="dc"+(allDone?" done":"")+(CUR_DAY===d-1?" on":"");
    chip.innerHTML=`<div class="dc-n">${d}</div><div class="dc-s">${s}</div>
      <div class="dc-dots">${dr.map(r=>{
        const c=SLOT_COL[r.slot]||"var(--trust)";
        const op=(STATUS[r.row]||r.status)==="Sudah"?"1":"0.3";
        return `<div class="dc-dot" style="background:${c};opacity:${op}"></div>`;
      }).join("")}</div>`;
    chip.addEventListener("click",()=>{CUR_DAY=d-1;renderDayGrid(rows);renderDetail(CUR_DAY,rows);});
    grid.appendChild(chip);
  }
}

// ── Slot Detail ────────────────────────────────────────────
const BADGE={Radar:"bh",Kalkulator:"bv",Dashboard:"bc"};
const LABEL={Radar:"Hook",Kalkulator:"Value",Dashboard:"Closing"};
function renderDetail(di,rows){
  const panel=document.getElementById("det-panel"); if(!panel) return;
  const dr=rows.filter(r=>r.day===di+1);
  if(!dr.length){panel.innerHTML=`<div style="padding:44px;text-align:center;color:var(--txt3);font-size:13px">Pilih hari di atas</div>`;return;}
  const s=dr[0].stock;
  const allDone=dr.every(r=>(STATUS[r.row]||r.status)==="Sudah");
  const flowStr=dr.map(r=>r.slot).join(" → ");
  panel.innerHTML=`
    <div class="det-hd">
      <div style="display:flex;align-items:baseline;gap:10px">
        <span class="det-stock">${s}</span>
        <span class="det-day">Hari ${di+1} &nbsp;|&nbsp; ${flowStr}</span>
      </div>
      <button class="btn-mark ${allDone?"on":""}" id="btn-mark" onclick="markDay(${di})">
        ${allDone?"✓ Selesai":"Tandai Selesai"}
      </button>
    </div>
    <div>${dr.map(r=>slotHTML(r)).join("")}</div>`;
}
function slotHTML(r){
  const sta=STATUS[r.row]||r.status||"Belum";
  const bc=BADGE[r.slot]||"bt";
  const lbl=LABEL[r.slot]||"Trust";
  const copyFull=r.copy+(r.link?`\n\n👉 ${r.link}`:"");
  // share platforms
  const platforms=[
    {id:"th",label:"Threads ↗",  direct:true,  url:`https://www.threads.net/intent/post?text=${enc(copyFull)}`},
    {id:"li",label:"LinkedIn ↗", direct:true,  url:`https://www.linkedin.com/sharing/share-offsite/?url=${enc("https://www.economstock.com")}&summary=${enc(r.copy)}`},
    {id:"tt",label:"TikTok",     direct:false, url:""},
    {id:"ig",label:"Instagram",  direct:false, url:""},
    {id:"sb",label:"Stockbit",   direct:false, url:""},
  ];
  // AI prompt share
  const aiPrompt=`Bantu saya buat copywriting menarik untuk saham ${r.stock} dengan konteks berikut:\n${r.copy}\n\nBuat 3 variasi dengan tone berbeda: (1) informatif, (2) curiosity-driven, (3) data-focused. Cocok untuk Instagram & Threads.`;

  return `<div class="slot-item">
    <div class="si-time">${r.time}</div>
    <div class="si-col">
      <span class="sbadge ${bc}">${r.slot}</span>
      <div class="si-status">
        <label>Status:</label>
        <select onchange="setStatus(${r.row},this.value,${r.day})">
          ${["Belum","Sudah","Skip"].map(s=>`<option ${s===sta?"selected":""}>${s}</option>`).join("")}
        </select>
      </div>
    </div>
    <div class="si-body">
      <div class="si-title">${r.stock} — ${lbl}</div>
      <div class="si-copy">${esc(r.copy)}</div>
      <div class="si-actions">
        ${r.link?`<a class="tool-lnk" href="${r.link}" target="_blank" rel="noopener">Buka tool ↗</a>`:""}
        <div class="share-wrap">
          <span class="share-lbl">Post:</span>
          ${platforms.map(p=>`<button class="sb sb-${p.id}" onclick="${p.direct
            ?`openUrl('${p.url.replace(/'/g,"\\'")}')`
            :`clipIt(${JSON.stringify(copyFull)},this)`}">${p.label}</button>`).join("")}
        </div>
      </div>
      <div class="ai-bar">
        <span class="ai-lbl">Bantu AI:</span>
        <a class="ai-btn ai-claude" href="https://claude.ai" target="_blank" rel="noopener" onclick="clipIt(${JSON.stringify(aiPrompt)},this)">Claude</a>
        <a class="ai-btn ai-gpt"    href="https://chatgpt.com" target="_blank" rel="noopener" onclick="clipIt(${JSON.stringify(aiPrompt)},this)">ChatGPT</a>
        <a class="ai-btn ai-gem"    href="https://gemini.google.com" target="_blank" rel="noopener" onclick="clipIt(${JSON.stringify(aiPrompt)},this)">Gemini</a>
        <span style="font-size:10px;color:var(--txt3);margin-left:4px">(prompt tersalin otomatis)</span>
      </div>
    </div>
  </div>`;
}

async function setStatus(rowNum,status,day){
  STATUS[rowNum]=status;
  const rows=getContent();
  const r=rows.find(x=>x.row===rowNum); if(r) r.status=status;
  renderDayGrid(rows); renderStats(rows,calcProg(rows));
  if(GAS_URL) await gasCall("updateStatus",{row:rowNum,status});
  toast("Status diperbarui"+(GAS_URL?" ke Google Sheet":""));
}

async function markDay(di){
  const rows=getContent();
  const dr=rows.filter(r=>r.day===di+1);
  const allDone=dr.every(r=>(STATUS[r.row]||r.status)==="Sudah");
  const nst=allDone?"Belum":"Sudah";
  for(const r of dr){
    STATUS[r.row]=nst; r.status=nst;
    if(GAS_URL) await gasCall("updateStatus",{row:r.row,status:nst});
  }
  renderDayGrid(rows); renderDetail(di,rows); renderStats(rows,calcProg(rows));
  toast(nst==="Sudah"?"Hari ditandai selesai ✓":"Hari direset");
}

