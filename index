// ═══════════════════════════════════════════════════════
// UTILS
// ═══════════════════════════════════════════════════════
function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;")}
function enc(s){return encodeURIComponent(s)}
function openUrl(u){window.open(u,"_blank","noopener")}
function clipIt(txt,btn){
  const s=typeof txt==="string"?txt.replace(/\\n/g,"\n"):txt;
  const copy=()=>{
    if(navigator.clipboard) return navigator.clipboard.writeText(s);
    const ta=document.createElement("textarea");ta.value=s;document.body.appendChild(ta);ta.select();document.execCommand("copy");document.body.removeChild(ta);return Promise.resolve();
  };
  copy().then(()=>{
    if(!btn) return;
    const orig=btn.textContent; btn.textContent="Tersalin!"; btn.classList.add("ok");
    setTimeout(()=>{btn.textContent=orig;btn.classList.remove("ok");},1800);
  });
}
function toast(msg){
  const t=document.getElementById("toast");t.textContent=msg;t.classList.add("on");
  clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove("on"),2600);
}
function goNav(el){
  document.querySelectorAll(".nv").forEach(n=>n.classList.remove("on"));
  el.classList.add("on");
  const p=el.dataset.p;
  document.querySelectorAll(".pane").forEach(x=>x.classList.remove("on"));
  document.getElementById("pane-"+p).classList.add("on");
}

