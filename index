<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>EconomStock — Command Center</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ─── RESET ──────────────────────────────────────────────────── */
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:     #080C14;   --bg2:#0E1525;   --bg3:#141D30;   --bg4:#1C2840;
  --bdr:    rgba(255,255,255,.06);      --bdr2:rgba(255,255,255,.11);
  --txt:    #D8E4F0;   --txt2:#6B84A8;  --txt3:#3A4F70;
  --gold:   #F2A007;   --gold2:#FFD166;
  --hook:   #E84545;   --value:#E0820A; --trust:#3B82F6; --close:#22C55E;
  --r:10px; --rl:14px; --rf:20px;
}
html,body{background:var(--bg);color:var(--txt);font-family:'Outfit',sans-serif;font-size:14px;min-height:100vh;line-height:1.5}
button{font-family:'Outfit',sans-serif;cursor:pointer}
input,select,textarea{font-family:'Outfit',sans-serif}

/* ─── LAYOUT ─────────────────────────────────────────────────── */
.shell{display:flex;min-height:100vh}
.side{width:230px;background:var(--bg2);border-right:1px solid var(--bdr);position:fixed;top:0;left:0;bottom:0;display:flex;flex-direction:column;z-index:40;overflow-y:auto}
.main{margin-left:230px;flex:1;padding:28px 30px;min-height:100vh}

/* sidebar */
.logo-wrap{padding:22px 20px 16px;border-bottom:1px solid var(--bdr)}
.logo{font-family:'Space Mono',monospace;font-size:12px;font-weight:700;color:var(--gold);letter-spacing:.1em}
.logo-tag{font-size:10px;color:var(--txt3);letter-spacing:.14em;text-transform:uppercase;margin-top:3px}
.nav-body{padding:14px 10px;flex:1}
.nav-sec{margin-bottom:22px}
.nav-sec-lbl{font-size:9px;color:var(--txt3);letter-spacing:.16em;text-transform:uppercase;padding:0 10px;margin-bottom:6px}
.nv{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:8px;cursor:pointer;font-size:12.5px;color:var(--txt2);transition:all .14s;border:1px solid transparent;font-weight:500}
.nv:hover{background:var(--bg3);color:var(--txt)}
.nv.on{background:var(--bg4);color:var(--gold);border-color:rgba(242,160,7,.14)}
.nv svg{width:14px;height:14px;flex-shrink:0;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.side-foot{padding:14px 16px;border-top:1px solid var(--bdr)}
.sync-btn{width:100%;padding:8px;background:rgba(242,160,7,.1);border:1px solid rgba(242,160,7,.22);color:var(--gold);font-size:12px;border-radius:8px;transition:all .14s;font-weight:600;letter-spacing:.02em}
.sync-btn:hover{background:rgba(242,160,7,.18)}
.sync-st{font-size:10px;color:var(--txt3);text-align:center;margin-top:6px;font-family:'Space Mono',monospace}

/* ─── TOPBAR ─────────────────────────────────────────────────── */
.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:26px}
.pg-title{font-family:'Outfit',sans-serif;font-size:20px;font-weight:700;color:var(--txt)}
.pg-title span{color:var(--gold)}
.topbar-r{display:flex;align-items:center;gap:10px}
.badge{font-size:10px;padding:3px 11px;border-radius:20px;letter-spacing:.06em;text-transform:uppercase;font-weight:600}
.badge-demo{background:rgba(232,69,69,.12);border:1px solid rgba(232,69,69,.25);color:var(--hook)}
.badge-live{background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.25);color:var(--close)}

/* ─── SETUP PANEL ────────────────────────────────────────────── */
.setup{background:var(--bg2);border:1px solid rgba(242,160,7,.2);border-radius:var(--rl);padding:22px 24px;margin-bottom:24px;position:relative;overflow:hidden}
.setup::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--gold),transparent)}
.setup-title{font-size:13px;font-weight:700;color:var(--gold);margin-bottom:14px;font-family:'Space Mono',monospace;letter-spacing:.04em}
.setup-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px}
.ss{background:var(--bg3);border-radius:var(--r);padding:12px 14px;border:1px solid var(--bdr)}
.ss-n{font-family:'Space Mono',monospace;font-size:10px;color:var(--gold);margin-bottom:5px}
.ss-t{font-size:11px;color:var(--txt2);line-height:1.55}
.ss-t code{background:var(--bg4);padding:1px 5px;border-radius:4px;font-size:10px;color:var(--gold2)}
.url-row{display:flex;gap:8px}
.url-in{flex:1;background:var(--bg);border:1px solid var(--bdr2);color:var(--txt);font-size:12px;padding:9px 14px;border-radius:8px;font-family:'Space Mono',monospace;outline:none;transition:border-color .14s}
.url-in:focus{border-color:rgba(242,160,7,.4)}
.url-in::placeholder{color:var(--txt3)}
.btn-conn{padding:9px 20px;background:var(--gold);color:#0A0E18;font-weight:700;font-size:12px;border:none;border-radius:8px;letter-spacing:.03em;transition:all .14s}
.btn-conn:hover{background:var(--gold2)}

/* ─── STAT ROW ───────────────────────────────────────────────── */
.stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}
.stat{background:var(--bg2);border:1px solid var(--bdr);border-radius:var(--rl);padding:16px 18px;position:relative;overflow:hidden}
.stat::after{content:'';position:absolute;top:0;left:0;right:0;height:2px}
.stat.h::after{background:var(--hook)} .stat.v::after{background:var(--value)}
.stat.t::after{background:var(--trust)}.stat.c::after{background:var(--close)}
.stat-lbl{font-size:10px;color:var(--txt3);text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px;font-weight:600}
.stat-n{font-family:'Space Mono',monospace;font-size:28px;color:var(--txt);margin-bottom:3px}
.stat-sub{font-size:11px;color:var(--txt2)}

/* ─── PROG ───────────────────────────────────────────────────── */
.prog-box{background:var(--bg2);border:1px solid var(--bdr);border-radius:var(--rl);padding:18px 22px;margin-bottom:22px}
.prog-hd{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
.prog-lbl{font-size:13px;font-weight:700;color:var(--txt)}
.prog-pct{font-family:'Space Mono',monospace;font-size:22px;color:var(--gold)}
.prog-track{height:5px;background:var(--bg4);border-radius:3px;overflow:hidden;margin-bottom:14px}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--gold),var(--gold2));border-radius:3px;transition:width .8s cubic-bezier(.4,0,.2,1)}
.wk-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.wk{text-align:center}
.wk-bar-w{height:44px;display:flex;align-items:flex-end;justify-content:center;margin-bottom:5px}
.wk-bar{width:26px;border-radius:4px 4px 0 0;background:var(--bg4);transition:height .5s ease}
.wk-bar.full{background:var(--close)}.wk-bar.part{background:var(--value)}
.wk-l{font-size:10px;color:var(--txt3)}.wk-c{font-family:'Space Mono',monospace;font-size:11px;color:var(--txt2);margin-top:2px}

/* ─── TWO COL ────────────────────────────────────────────────── */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:22px}
.card{background:var(--bg2);border:1px solid var(--bdr);border-radius:var(--rl);overflow:hidden}
.card-hd{padding:13px 18px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between}
.card-ttl{font-size:12.5px;font-weight:700;color:var(--txt);letter-spacing:.02em}
.card-body{padding:16px 18px}

/* ─── TABLE ──────────────────────────────────────────────────── */
.tbl{width:100%;border-collapse:collapse}
.tbl th{font-size:9px;color:var(--txt3);text-transform:uppercase;letter-spacing:.12em;padding:6px 8px;border-bottom:1px solid var(--bdr);font-weight:600;text-align:center}
.tbl th:first-child{text-align:left}
.tbl td{padding:9px 8px;font-size:11.5px;border-bottom:1px solid var(--bdr);color:var(--txt2)}
.tbl td:first-child{color:var(--txt);font-weight:500}
.tbl td:not(:first-child){text-align:center}
.tbl tr:last-child td{border-bottom:none}
.cr{color:#4ADE80!important;font-family:'Space Mono',monospace;font-size:10.5px}
.ct{color:#60A5FA!important;font-family:'Space Mono',monospace;font-size:10.5px}
.ca{color:#F87171!important;font-family:'Space Mono',monospace;font-size:10.5px}
.act-in{background:var(--bg);border:1px solid var(--bdr2);color:var(--txt);font-size:11px;padding:3px 8px;border-radius:6px;font-family:'Space Mono',monospace;width:90px;text-align:center;outline:none;transition:border-color .14s}
.act-in:focus{border-color:rgba(242,160,7,.4)}

/* ─── DAY GRID ───────────────────────────────────────────────── */
.day-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:22px}
.dc{background:var(--bg2);border:1px solid var(--bdr);border-radius:10px;padding:8px 6px;cursor:pointer;text-align:center;transition:all .14s}
.dc:hover{background:var(--bg3);border-color:var(--bdr2)}
.dc.on{background:var(--bg3);border-color:rgba(242,160,7,.35)}
.dc.done{opacity:.5}
.dc-n{font-family:'Space Mono',monospace;font-size:12px;color:var(--txt2);margin-bottom:3px}
.dc.on .dc-n{color:var(--gold)}
.dc-s{font-size:10px;font-weight:700;color:var(--txt);letter-spacing:.04em}
.dc.done .dc-s{color:var(--txt3)}
.dc-dots{display:flex;gap:2px;justify-content:center;margin-top:5px}
.dc-dot{width:5px;height:5px;border-radius:50%}

/* ─── DETAIL PANEL ───────────────────────────────────────────── */
.det{background:var(--bg2);border:1px solid var(--bdr);border-radius:var(--rl);overflow:hidden;margin-bottom:22px}
.det-hd{padding:14px 20px;background:var(--bg3);border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between}
.det-stock{font-family:'Space Mono',monospace;font-size:22px;font-weight:700;color:var(--gold);margin-right:10px}
.det-day{font-size:11px;color:var(--txt3);font-family:'Space Mono',monospace}
.btn-mark{font-size:11px;padding:6px 16px;border-radius:8px;background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.2);color:var(--close);font-weight:600;transition:all .14s}
.btn-mark:hover{background:rgba(34,197,94,.2)} .btn-mark.on{background:rgba(34,197,94,.22);border-color:var(--close)}
.slot-item{padding:14px 20px;border-bottom:1px solid var(--bdr);display:grid;grid-template-columns:48px 88px 1fr;gap:14px;align-items:start}
.slot-item:last-child{border-bottom:none}
.si-time{font-family:'Space Mono',monospace;font-size:11px;color:var(--txt3);padding-top:3px}
.si-col{}
.sbadge{font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;letter-spacing:.04em;display:inline-block}
.bh{background:rgba(232,69,69,.14);color:#F87171;border:1px solid rgba(232,69,69,.2)}
.bv{background:rgba(224,130,10,.14);color:#FCA72A;border:1px solid rgba(224,130,10,.2)}
.bt{background:rgba(59,130,246,.14);color:#7DB8F5;border:1px solid rgba(59,130,246,.2)}
.bc{background:rgba(34,197,94,.14);color:#6EE7A0;border:1px solid rgba(34,197,94,.2)}
.si-status{display:flex;align-items:center;gap:5px;margin-top:7px}
.si-status label{font-size:10px;color:var(--txt3)}
.si-status select{font-size:10px;padding:3px 7px;border-radius:6px;background:var(--bg);border:1px solid var(--bdr2);color:var(--txt);outline:none;cursor:pointer}
.si-body{}
.si-title{font-size:13px;font-weight:600;color:var(--txt);margin-bottom:8px}
.si-copy{font-size:12px;color:var(--txt2);line-height:1.75;white-space:pre-wrap;background:var(--bg3);border:1px solid var(--bdr);border-radius:8px;padding:10px 12px;margin-bottom:10px}
.si-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.tool-lnk{font-size:11px;color:var(--trust);background:rgba(59,130,246,.1);border:1px solid rgba(59,130,246,.2);padding:4px 12px;border-radius:20px;text-decoration:none;transition:all .13s;display:inline-block}
.tool-lnk:hover{background:rgba(59,130,246,.2)}

/* ─── SHARE BUTTONS ──────────────────────────────────────────── */
.share-wrap{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.share-lbl{font-size:10px;color:var(--txt3);font-weight:600;margin-right:2px}
.sb{font-size:10px;font-weight:600;padding:3px 10px;border-radius:20px;border:1px solid var(--bdr2);color:var(--txt2);background:var(--bg3);transition:all .12s;letter-spacing:.02em}
.sb:hover{color:var(--txt);border-color:var(--bdr2);background:var(--bg4)}
.sb.ok{background:rgba(34,197,94,.1);color:var(--close);border-color:rgba(34,197,94,.3)!important}
.sb-th:hover{border-color:#999;color:#ccc}
.sb-li:hover{border-color:#60A5FA;color:#60A5FA}
.sb-tt:hover{border-color:#eee;color:#eee}
.sb-ig:hover{border-color:#F472B6;color:#F472B6}
.sb-sb:hover{border-color:#FB923C;color:#FB923C}

/* ─── AI ASSISTANT BUTTONS ───────────────────────────────────── */
.ai-bar{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:8px;padding-top:8px;border-top:1px solid var(--bdr)}
.ai-lbl{font-size:10px;color:var(--txt3);font-weight:600;margin-right:2px}
.ai-btn{font-size:10px;font-weight:600;padding:3px 11px;border-radius:20px;border:1px solid;transition:all .13s;text-decoration:none;display:inline-block;letter-spacing:.02em}
.ai-claude{border-color:rgba(215,140,80,.4);color:#E8A96A;background:rgba(215,140,80,.08)}
.ai-claude:hover{background:rgba(215,140,80,.16);text-decoration:none}
.ai-gpt{border-color:rgba(25,195,125,.4);color:#3DCA96;background:rgba(25,195,125,.08)}
.ai-gpt:hover{background:rgba(25,195,125,.16);text-decoration:none}
.ai-gem{border-color:rgba(66,133,244,.4);color:#78AAFF;background:rgba(66,133,244,.08)}
.ai-gem:hover{background:rgba(66,133,244,.16);text-decoration:none}

/* ─── KPI GRID ───────────────────────────────────────────────── */
.kpi-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:22px}
.kpi-card{background:var(--bg2);border:1px solid var(--bdr);border-radius:var(--rl);padding:16px 18px}
.kpi-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px}
.kpi-name{font-size:12px;font-weight:600;color:var(--txt2)}
.kpi-tags{display:flex;gap:5px}
.kpi-min{font-size:10px;padding:2px 8px;border-radius:12px;background:rgba(242,160,7,.1);color:var(--gold);border:1px solid rgba(242,160,7,.2)}
.kpi-good{font-size:10px;padding:2px 8px;border-radius:12px;background:rgba(34,197,94,.1);color:var(--close);border:1px solid rgba(34,197,94,.2)}
.kpi-weeks{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.kw-lbl{font-size:9px;color:var(--txt3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:4px}
.kw-in{width:100%;background:var(--bg);border:1px solid var(--bdr);color:var(--txt);font-size:12px;padding:5px 4px;text-align:center;border-radius:6px;font-family:'Space Mono',monospace;outline:none;transition:border-color .14s}
.kw-in:focus{border-color:rgba(242,160,7,.4)}

/* ─── TEMPLATE ───────────────────────────────────────────────── */
.tmpl-grid{display:grid;gap:14px}
.tmpl-card{background:var(--bg2);border:1px solid var(--bdr);border-radius:var(--rl);overflow:hidden}
.tmpl-hd{padding:11px 16px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;gap:10px;background:var(--bg3)}
.tmpl-body{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px 16px}
.tmpl-opt{background:var(--bg3);border:1px solid var(--bdr);border-radius:8px;padding:11px 13px;position:relative}
.tmpl-opt-lbl{font-size:9px;color:var(--txt3);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px}
.tmpl-txt{font-size:12px;color:var(--txt2);line-height:1.7;white-space:pre-wrap}
.cp-btn{position:absolute;top:8px;right:8px;font-size:9px;padding:2px 8px;border-radius:5px;background:var(--bg4);border:1px solid var(--bdr2);color:var(--txt3);transition:all .12s}
.cp-btn:hover{color:var(--txt)} .cp-btn.ok{background:rgba(34,197,94,.1);color:var(--close);border-color:rgba(34,197,94,.3)}

/* ─── TARGET PAGE ────────────────────────────────────────────── */
.level-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:22px}
.lv{border-radius:var(--rl);overflow:hidden;border:1px solid var(--bdr)}
.lv-hd{padding:12px 16px;font-size:12px;font-weight:700;text-align:center}
.lv-r .lv-hd{background:rgba(74,222,128,.1);color:#4ADE80;border-bottom:1px solid rgba(74,222,128,.15)}
.lv-t .lv-hd{background:rgba(96,165,250,.1);color:#60A5FA;border-bottom:1px solid rgba(96,165,250,.15)}
.lv-a .lv-hd{background:rgba(248,113,113,.1);color:#F87171;border-bottom:1px solid rgba(248,113,113,.15)}
.lv-body{background:var(--bg2);padding:14px 16px}
.lv-row{display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid var(--bdr);font-size:12px}
.lv-row:last-child{border-bottom:none}
.lv-met{color:var(--txt2)} .lv-val{font-family:'Space Mono',monospace;font-size:11px}
.lv-r .lv-val{color:#4ADE80} .lv-t .lv-val{color:#60A5FA} .lv-a .lv-val{color:#F87171}

/* ─── INSIGHT BOX ────────────────────────────────────────────── */
.insight{background:var(--bg2);border-left:3px solid var(--trust);border-radius:var(--r);padding:12px 16px;font-size:12px;color:var(--txt2);line-height:1.7;margin-bottom:22px}
.insight strong{color:var(--txt)}

/* ─── PANES ──────────────────────────────────────────────────── */
.pane{display:none}.pane.on{display:block}

/* ─── TOAST ──────────────────────────────────────────────────── */
.toast{position:fixed;bottom:22px;right:22px;z-index:999;background:var(--bg3);border:1px solid var(--bdr2);color:var(--txt);font-size:12px;padding:10px 18px;border-radius:10px;box-shadow:0 6px 28px rgba(0,0,0,.45);transform:translateY(70px);opacity:0;transition:all .22s;pointer-events:none;font-weight:500}
.toast.on{transform:translateY(0);opacity:1}

/* ─── LOADER ─────────────────────────────────────────────────── */
.loader{position:fixed;inset:0;background:var(--bg);z-index:200;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px}
.spin{width:30px;height:30px;border:2px solid var(--bg4);border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.load-txt{font-family:'Space Mono',monospace;font-size:11px;color:var(--txt3)}
@keyframes up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.fade{animation:up .28s ease both}
</style>
</head>
<body>

<div class="loader" id="loader">
  <div class="spin"></div>
  <div class="load-txt" id="load-txt">Memuat dashboard...</div>
</div>
<div class="toast" id="toast"></div>

<div class="shell">

<!-- ─────────── SIDEBAR ─────────── -->
<aside class="side">
  <div class="logo-wrap">
    <div class="logo">ECONOMSTOCK</div>
    <div class="logo-tag">Content Command Center</div>
  </div>
  <nav class="nav-body">
    <div class="nav-sec">
      <div class="nav-sec-lbl">Overview</div>
      <div class="nv on" data-p="dash" onclick="goNav(this)">
        <svg viewBox="0 0 16 16"><rect x="1" y="1" width="6" height="6" rx="1.5"/><rect x="9" y="1" width="6" height="6" rx="1.5"/><rect x="1" y="9" width="6" height="6" rx="1.5"/><rect x="9" y="9" width="6" height="6" rx="1.5"/></svg>
        Dashboard
      </div>
      <div class="nv" data-p="target" onclick="goNav(this)">
        <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5"/><circle cx="8" cy="8" r="3.5"/><circle cx="8" cy="8" r="1"/></svg>
        Target 3 Level
      </div>
    </div>
    <div class="nav-sec">
      <div class="nav-sec-lbl">Konten</div>
      <div class="nv" data-p="kal" onclick="goNav(this)">
        <svg viewBox="0 0 16 16"><rect x="1.5" y="2.5" width="13" height="12" rx="1.5"/><path d="M1.5 6h13M5 1v3M11 1v3"/></svg>
        Kalender 30 Hari
      </div>
      <div class="nv" data-p="tmpl" onclick="goNav(this)">
        <svg viewBox="0 0 16 16"><path d="M3 4h10M3 8h8M3 12h6"/></svg>
        Template Copy
      </div>
    </div>
    <div class="nav-sec">
      <div class="nav-sec-lbl">Analytics</div>
      <div class="nv" data-p="kpi" onclick="goNav(this)">
